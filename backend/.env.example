# Copy to backend/.env to override defaults.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Default: backend/lingo.db. Use an absolute path (4 slashes) or a relative one (3 slashes).
# DATABASE_URL=sqlite:////absolute/path/to/lingo.db
# Minutes per regenerated heart (default 30). Use 1 for a quick demo.
# HEART_REGEN_MINUTES=30
