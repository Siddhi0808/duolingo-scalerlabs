          "title": "Greetings",
          "icon": "wave",
          "description": "Say hello, goodbye and ask how someone is.",
          "lessons": [
            {
              "title": "Hello and goodbye",
              "exercises": [
                {"type": "multiple_choice", "prompt": "Which one means “hello”?", "options": ["adiós", "hola", "gracias"], "answer": "hola"},
                {"type": "matching_pairs", "pairs": [["hello", "hola"], ["goodbye", "adiós"], ["thank you", "gracias"], ["please", "por favor"]]},
                {"type": "fill_blank", "sentence": "___, ¿cómo estás?", "options": ["Hola", "Adiós", "Gracias"], "answer": "Hola", "hint": "Hello, how are you?"},
                {"type": "word_bank", "source": "Good morning", "answer": "Buenos días", "distractors": ["noches", "tardes", "Buenas"]},
                {"type": "type_answer", "source": "Hello", "answer": "Hola"}
              ]
            },
            {
              "title": "Morning and night",
              "exercises": [
                {"type": "multiple_choice", "prompt": "Which one means “good night”?", "options": ["buenos días", "buenas tardes", "buenas noches"], "answer": "buenas noches"},
                {"type": "word_bank", "source": "Good afternoon", "answer": "Buenas tardes", "distractors": ["días", "noches", "Buenos"]},
                {"type": "fill_blank", "sentence": "Buenas ___, hasta mañana.", "options": ["noches", "días", "gracias"], "answer": "noches", "hint": "Good night, see you tomorrow."},
                {"type": "type_answer", "source": "Good morning", "answer": "Buenos días", "also": ["Buen día"]},
                {"type": "multiple_choice", "prompt": "What does “hasta luego” mean?", "options": ["good morning", "see you later", "thank you"], "answer": "see you later"}
              ]
            },
            {
              "title": "How are you?",
              "exercises": [
                {"type": "word_bank", "source": "How are you?", "answer": "¿Cómo estás?", "distractors": ["Qué", "eres", "bien"]},
                {"type": "multiple_choice", "prompt": "How do you say “I'm fine, thanks”?", "options": ["Estoy mal, gracias", "Estoy bien, gracias", "Soy bien, gracias"], "answer": "Estoy bien, gracias"},
                {"type": "fill_blank", "sentence": "Estoy ___, gracias. ¿Y tú?", "options": ["bien", "hola", "noches"], "answer": "bien", "hint": "I'm fine, thanks. And you?"},
                {"type": "matching_pairs", "pairs": [["good", "bien"], ["bad", "mal"], ["so-so", "más o menos"], ["and you?", "¿y tú?"]]},
                {"type": "type_answer", "source": "Thank you", "answer": "Gracias"},
                {"type": "word_bank", "to": "en", "source": "Estoy muy bien", "answer": "I am very well", "also": ["I am very good"], "distractors": ["you", "are"]}
              ]
            }
          ]
        },
        {
          "key": "introductions",
          "title": "Introductions",
          "icon": "id",
          "description": "Say your name, what you do and where you are from.",
          "lessons": [
            {
              "title": "My name is…",
              "exercises": [
                {"type": "multiple_choice", "prompt": "How do you say “My name is Ana”?", "options": ["Me llamo Ana", "Te llamas Ana", "Se llama Ana"], "answer": "Me llamo Ana"},
                {"type": "word_bank", "source": "My name is Carlos", "answer": "Me llamo Carlos", "also": ["Mi nombre es Carlos"], "distractors": ["Te"]},
                {"type": "fill_blank", "sentence": "¿Cómo te ___?", "options": ["llamas", "llamo", "llama"], "answer": "llamas", "hint": "What's your name?", "explanation": "With “te” (you), the verb ends in -as: te llamas."},
                {"type": "type_answer", "source": "What is your name?", "answer": "¿Cómo te llamas?", "also": ["¿Cuál es tu nombre?"]},
                {"type": "matching_pairs", "pairs": [["my name is", "me llamo"], ["your name is", "te llamas"], ["his name is", "se llama"], ["nice to meet you", "mucho gusto"]]}
              ]
            },
            {
              "title": "I am…",
              "exercises": [
                {"type": "multiple_choice", "prompt": "Which one means “I am a student”?", "options": ["Eres estudiante", "Es estudiante", "Soy estudiante"], "answer": "Soy estudiante"},
                {"type": "fill_blank", "sentence": "Yo ___ profesora.", "options": ["soy", "eres", "es"], "answer": "soy", "hint": "I am a teacher."},
                {"type": "word_bank", "source": "You are my friend", "answer": "Tú eres mi amigo", "also": ["Eres mi amigo"], "distractors": ["soy", "su"]},
                {"type": "type_answer", "source": "I am Ana", "answer": "Soy Ana", "also": ["Yo soy Ana"]},
                {"type": "multiple_choice", "prompt": "What does “mucho gusto” mean?", "options": ["very good", "nice to meet you", "see you tomorrow"], "answer": "nice to meet you"}
              ]
            },
            {
              "title": "Where are you from?",
              "exercises": [
                {"type": "matching_pairs", "pairs": [["Spain", "España"], ["Mexico", "México"], ["Germany", "Alemania"], ["England", "Inglaterra"]]},
                {"type": "fill_blank", "sentence": "Soy ___ México.", "options": ["de", "en", "con"], "answer": "de", "hint": "I am from Mexico.", "explanation": "Use “ser de” to say where someone is from."},
                {"type": "word_bank", "source": "Where are you from?", "answer": "¿De dónde eres?", "distractors": ["estás", "Cómo"]},
                {"type": "multiple_choice", "prompt": "How do you say “I live in Madrid”?", "options": ["Soy en Madrid", "Voy a Madrid", "Vivo en Madrid"], "answer": "Vivo en Madrid"},
                {"type": "type_answer", "source": "I am from Spain", "answer": "Soy de España", "also": ["Yo soy de España"]},
                {"type": "word_bank", "to": "en", "source": "Ella es de Colombia", "answer": "She is from Colombia", "distractors": ["He", "in"]}
              ]
            }
          ]
        },
