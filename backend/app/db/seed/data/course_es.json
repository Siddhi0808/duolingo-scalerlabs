          "icon": "book",
          "description": "People, animals and everyday things.",
          "lessons": [
            {
              "title": "People",
              "exercises": [
                {"type": "multiple_choice", "prompt": "Which one is “the woman”?", "options": ["el hombre", "la mujer", "el niño", "la niña"], "answer": "la mujer", "images": {"el hombre": "👨", "la mujer": "👩", "el niño": "👦", "la niña": "👧"}},
                {"type": "matching_pairs", "pairs": [["the man", "el hombre"], ["the boy", "el niño"], ["the girl", "la niña"], ["the friend", "el amigo"]]},
                {"type": "fill_blank", "sentence": "___ niña come pan.", "options": ["La", "El", "Los"], "answer": "La", "hint": "The girl eats bread.", "explanation": "“Niña” is feminine and singular, so it takes “la”."},
                {"type": "word_bank", "source": "The man and the woman", "answer": "El hombre y la mujer", "distractors": ["niño", "o"]},
                {"type": "type_answer", "source": "the boy", "answer": "el niño"}
              ]
            },
            {
              "title": "Animals and things",
              "exercises": [
                {"type": "multiple_choice", "prompt": "Which one is “the cat”?", "options": ["el perro", "el gato", "el libro"], "answer": "el gato", "images": {"el perro": "🐶", "el gato": "🐱", "el libro": "📕"}},
                {"type": "fill_blank", "sentence": "Tengo un ___ negro.", "options": ["perro", "casa", "mujer"], "answer": "perro", "hint": "I have a black dog."},
                {"type": "matching_pairs", "pairs": [["dog", "perro"], ["cat", "gato"], ["house", "casa"], ["car", "coche"], ["book", "libro"]]},
                {"type": "multiple_choice", "prompt": "Which one is “the book”?", "options": ["el libro", "la casa", "el coche"], "answer": "el libro", "images": {"el libro": "📕", "la casa": "🏠", "el coche": "🚗"}},
                {"type": "word_bank", "source": "The cat is small", "answer": "El gato es pequeño", "distractors": ["grande", "perro"]},
                {"type": "type_answer", "source": "the house", "answer": "la casa"}
              ]
            }
          ]
        }
